{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrixHaloXrtSmokeReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "fingerprintId",
    "canonical",
    "timestamp",
    "program",
    "context",
    "result",
    "failure"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "xrtSmoke" },
    "fingerprintId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "program": {
      "type": "object",
      "required": [
        "target",
        "abi",
        "programSha256",
        "xclbinSha256",
        "elfSha256"
      ],
      "properties": {
        "target": { "type": "string", "const": "npu2" },
        "abi": { "type": "string", "const": "xrt-elf-v1" },
        "programSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "xclbinSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "elfSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "deviceCount",
        "deviceIndex",
        "deviceName",
        "npuArchitecture",
        "xclbinUuid",
        "kernelName",
        "contextMode",
        "partitionColumns",
        "resourceEvidence",
        "inputBytes",
        "outputBytes",
        "boAllocations",
        "buffersReused"
      ],
      "properties": {
        "contextMode": {
          "type": "string",
          "enum": ["shared", "exclusive"]
        },
        "partitionColumns": { "type": "integer", "minimum": 1 },
        "resourceEvidence": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status",
        "completionStatus",
        "iterations",
        "completedIterations",
        "timeoutMs",
        "quarantined",
        "firstMismatch"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["completed", "failed"] },
        "completionStatus": { "type": "string" },
        "iterations": { "type": "integer", "minimum": 1 },
        "completedIterations": { "type": "integer", "minimum": 0 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "quarantined": { "type": "boolean" },
        "firstMismatch": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}
