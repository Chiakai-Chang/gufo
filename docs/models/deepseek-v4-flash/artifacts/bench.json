{
  "schema": "gufo-model-bench/1",
  "category": "llm",
  "model": {
    "id": "DeepSeek-V4-Flash",
    "docs": "deepseek-v4-flash"
  },
  "files": {
    "gguf": "target GGUF (IQ2XXS mixed, antirez/deepseek-v4-gguf)",
    "dspark": "DSpark support GGUF"
  },
  "variants": {
    "default": {
      "label": "Flash 0731",
      "requires": [
        "gguf",
        "dspark"
      ]
    }
  },
  "sampling": {
    "temperature": 0,
    "seed": 1
  },
  "speculative": {
    "mode": "dspark",
    "label": "DSpark",
    "gufo_args": [
      "--dspark-model",
      "{dspark}"
    ],
    "reference": "ar"
  },
  "tables": {
    "loading": {
      "title": "Cold-file-cache launch to readiness",
      "per_variant": false,
      "context": 4096,
      "sessions": 2,
      "repetitions": 1,
      "metric": "seconds",
      "better": "lower",
      "rows": "variants"
    },
    "single-ar": {
      "title": "Single user, autoregressive",
      "per_variant": false,
      "prompt_tokens": 2048,
      "output_tokens": 128,
      "depths": [
        0,
        4096,
        8192,
        12288,
        16384,
        32768,
        65536
      ],
      "context": 67712,
      "depth_tolerance": 0.005,
      "prefix": {
        "generator": "synthetic-paragraphs",
        "seed": 1
      },
      "repetitions": 1,
      "metric": "tok/s",
      "better": "higher"
    },
    "single-dspark": {
      "title": "Single user, DSpark",
      "per_variant": false,
      "speculative": true,
      "prompt_tokens": 2048,
      "output_tokens": 128,
      "depths": [
        0,
        4096,
        8192,
        12288,
        16384,
        32768,
        65536
      ],
      "context": 67712,
      "depth_tolerance": 0.005,
      "prefix": {
        "generator": "synthetic-paragraphs",
        "seed": 1
      },
      "repetitions": 1,
      "metric": "tok/s",
      "better": "higher"
    },
    "multi-repetition": {
      "title": "Multiple users, repetition",
      "per_variant": false,
      "modes": [
        "ar",
        "dspark"
      ],
      "suite": "../../qwen3.8-27b/artifacts/speculative-corpus.json",
      "cases": [
        "repetition_word"
      ],
      "corpus_layout": "homogeneous",
      "concurrency": [
        1,
        2,
        4,
        6,
        8
      ],
      "context": 4096,
      "output_tokens": 128,
      "cache_prompt": false,
      "warmup": 1,
      "repetitions": 1,
      "metric": "tok/s",
      "better": "higher"
    },
    "multi-mixed": {
      "title": "Multiple users, mixed corpus",
      "per_variant": false,
      "modes": [
        "ar",
        "dspark"
      ],
      "suite": "../../qwen3.8-27b/artifacts/speculative-corpus.json",
      "cases": [
        "expository_pangram",
        "cpp_ring_buffer",
        "reasoning_train",
        "summary_gpu",
        "italian_explanation",
        "chinese_explanation",
        "json_schedule",
        "creative_station",
        "instruction_debug"
      ],
      "corpus_layout": "distinct",
      "concurrency": [
        1,
        2,
        4,
        6,
        8
      ],
      "context": 4096,
      "output_tokens": 128,
      "cache_prompt": false,
      "warmup": 1,
      "repetitions": 1,
      "metric": "tok/s",
      "better": "higher"
    },
    "memory": {
      "title": "GPU-visible allocation",
      "per_variant": false,
      "context": 262144,
      "workloads": [
        {
          "id": "pp2048 + tg128",
          "depth": 0,
          "prompt_tokens": 2048,
          "output_tokens": 128
        },
        {
          "id": "16K prefix, pp4096 + tg128",
          "depth": 16384,
          "prompt_tokens": 4096,
          "output_tokens": 128
        }
      ],
      "metric": "GiB",
      "better": "lower"
    }
  },
  "gufo": {
    "serve": [],
    "llm": [
      "--think",
      "off",
      "--max-pending-per-client",
      "8"
    ],
    "readiness": "/ready"
  },
  "reference": {
    "name": "llama.cpp",
    "server": "llama-server",
    "args": [
      "-ngl",
      "999",
      "-fa",
      "on",
      "--cache-reuse",
      "0",
      "--jinja",
      "--reasoning",
      "off"
    ],
    "endpoint_profile": "openai",
    "readiness": "/health"
  }
}
